NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 客服中心：所有用户点「客服中心」会打开与这位用户的私信线程（Supabase Auth 的 user id，与 public.users.id 一致）。
# 对应账号需在应用内注册；建议与下方邮箱为同一账号。生产环境务必在 Netlify / Vercel 环境变量中填写。
SUPPORT_MANAGER_USER_ID=

# 注册后无需邮箱验证、立即拿到 Session：
# Supabase Dashboard → Authentication → Providers → Email
# 关闭「Confirm email」（并保存）。纯控制台配置，无法仅靠本仓库代码关闭。
#
# 在 Supabase 一眼查看「邮箱 + student/tutor」：
# 1) 运行 supabase/users-auth-role-view.sql（Table Editor → users_auth_role_summary）
# 2) 或 Authentication → 点用户 → User Metadata 里的 role / full_name

# Site URL for absolute links (optional). Terms link defaults to /terms.html when unset.
NEXT_PUBLIC_SITE_URL=
# Optional override for Android APK direct link (e.g. GitHub Releases asset URL)
NEXT_PUBLIC_ANDROID_APK_URL=
# Override terms page URL (optional). Defaults to NEXT_PUBLIC_SITE_URL/terms.html or /terms.html
NEXT_PUBLIC_TERMS_URL=

# Landing "Contact" section (public; safe to expose in the browser bundle)
NEXT_PUBLIC_CONTACT_WECHAT=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_HOURS=

# Optional social links (footer icons; leave empty to show disabled gray icons)
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61589697296280
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=

# iOS — set after App Store / TestFlight publish (shows buttons on /download page)
NEXT_PUBLIC_IOS_APP_STORE_URL=
NEXT_PUBLIC_IOS_TESTFLIGHT_URL=

# PWA Web Push (iOS 16.4+ after Add to Home Screen; also Chrome/Android)
# Run: npm run generate:vapid — then set both keys on Netlify and redeploy
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@astarmarktetplace.netlify.app

# Push notifications (server-side)
SUPABASE_SERVICE_ROLE_KEY=
# Homepage stats: displayed = BASE + live DB count (where applicable).
# Student: BASE + role=student. Active demand (30d): BASE + tutor_directory_filter_events. Tutor = tutor_profiles only.
LANDING_STAT_BASE_STUDENTS=22
LANDING_STAT_BASE_ACTIVE_DEMANDS=23
LANDING_STAT_FLOOR_BOOKING_MATCHES=16
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional alternative: paste full service-account JSON (single-line string)
FIREBASE_SERVICE_ACCOUNT_JSON=
