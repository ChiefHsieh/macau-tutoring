# Copy this file to keystore.properties (same folder as this example) and fill in real values.
# keystore.properties is gitignored — never commit it or your .jks file.
#
# Create the keystore once (or use Android Studio: Build → Generate Signed App Bundle → Create new...):
#   keytool ... -alias key0
#
# Android Studio 新建密钥库时默认 Alias 多为 key0；下方 keyAlias 请与创建时一致。
#
# Put release-upload.jks in this android/ folder (next to keystore.properties), then set:

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=key0
storeFile=release-upload.jks
