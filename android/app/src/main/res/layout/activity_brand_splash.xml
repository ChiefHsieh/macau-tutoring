<?xml version="1.0" encoding="utf-8"?>
<!-- Matches Loading Page layout: logo visually centered; bilingual taglines pinned to bottom.
     Use a logo PNG that does NOT include the three quality lines (export logo-only from design). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_background">

    <ImageView
        android:id="@+id/splash_logo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:maxWidth="320dp"
        android:src="@drawable/splash_logo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.44" />

    <LinearLayout
        android:id="@+id/splash_taglines"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/splash_tagline_en"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.92"
            android:gravity="center"
            android:text="@string/splash_tagline_en"
            android:textColor="@color/splash_tagline"
            android:textSize="15sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/splash_tagline_zh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.95"
            android:gravity="center"
            android:text="@string/splash_tagline_zh"
            android:textColor="@color/splash_tagline"
            android:textSize="15sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
