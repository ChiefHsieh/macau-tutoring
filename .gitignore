# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
android/app/google-services.json
test-results/

# Capacitor iOS — do not commit CocoaPods artifacts (commit ios/App native project)
ios/App/Pods/
ios/App/build/
ios/**/DerivedData/
**/ios/**/*.xcuserstate

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# APK hosted via GitHub Releases or copied before deploy
/public/downloads/*.apk

